(version 1)
# Copperpath PCB: JLCPCB manufacturing limits (standard process, 1 oz copper).
# Source: jlcpcb.com/capabilities (checked 2026-11). Board Setup > Constraints
# holds the global minimums. These rules add the cases that need a condition.

(rule "PTH hole to track"
	(condition "A.isPlated() && B.Type == 'Track' && A.Net != B.Net")
	(constraint hole_clearance (min 0.33mm)))

(rule "NPTH hole to track"
	(condition "!A.isPlated() && B.Type == 'Track'")
	(constraint hole_clearance (min 0.254mm)))

(rule "Pad to track"
	(condition "A.Type == 'Pad' && B.Type == 'Track' && A.Net != B.Net")
	(constraint clearance (min 0.2mm)))

(rule "Hole to hole, different nets"
	(condition "A.Net != B.Net")
	(constraint hole_to_hole (min 0.5mm)))

(rule "NPTH minimum diameter"
	(condition "!A.isPlated()")
	(constraint hole_size (min 0.5mm)))

(rule "Castellated hole minimum diameter"
	(condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad'")
	(constraint hole_size (min 0.6mm)))

(rule "PTH pad annular ring"
	(condition "A.Type == 'Pad' && A.isPlated()")
	(constraint annular_width (min 0.13mm)))

(rule "Silkscreen text"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Text Box'")
	(constraint text_height (min 1mm))
	(constraint text_thickness (min 0.15mm)))
